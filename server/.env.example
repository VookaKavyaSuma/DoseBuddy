# Server Port
PORT=8080

# URLs & Origins
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://dose-buddy.vercel.app
BACKEND_BASE_URL=http://localhost:8080

# Database Configuration (MySQL / Aiven Cloud)
DB_URL=jdbc:mysql://localhost:3306/dosebuddy?sslMode=REQUIRED
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Authentication (JWT Secret)
JWT_SECRET=your_jwt_secret_key_base64

# External APIs & AI Services
GOOGLE_API_KEY=your_google_gemini_api_key
PINECONE_API_KEY=your_pinecone_api_key
